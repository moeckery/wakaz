{
  "name": "ranna-lab",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 4180",
    "build": "nuxt generate",
    "typecheck": "nuxt typecheck",
    "test": "node --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "nuxt": "4.6.4",
    "primevue": "4.5.5",
    "reka-ui": "2.11.0",
    "uqr": "0.1.3",
    "vue": "3.5.44",
    "vue-qrcode-reader": "5.7.3",
    "vue-router": "5.4.0",
    "zxing-wasm": "1.1.3"
  },
  "devDependencies": {
    "@nuxtjs/i18n": "10.6.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.14"
  }
}
